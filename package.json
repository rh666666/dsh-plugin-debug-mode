{
  "name": "dsh-plugin-debug-mode",
  "version": "0.22.1",
  "description": "Cursor-Agent 式调试插件：让 Agent 在代码库中埋探针取证，由你确认问题是否解决。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "debug",
    "probe",
    "logging"
  ],
  "type": "module",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.5-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./probe": {
      "default": "./lib/probe.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "license": "MIT"
}
